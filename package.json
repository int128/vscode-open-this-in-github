{
  "name": "vscode-extension-helloworld",
  "version": "1.0.0",
  "description": "Hello World extension for Visual Studio Code",
  "publisher": "int128",
  "main": "index.ts",
  "type": "module",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "extension.helloWorld",
        "title": "Hello World"
      }
